<UserControl x:Class="KDCtrlLib.KDControls.KDProgressBar"
			 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
			 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
			 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
			 xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
			 xmlns:local="clr-namespace:KDCtrlLib.KDControls"
			 xmlns:converter="clr-namespace:KDCtrlLib.KDConverters"
			 x:Name="UC"
			 mc:Ignorable="d" >
	<UserControl.Resources>
		<Style
			x:Key="{x:Type ProgressBar}"
			TargetType="{x:Type ProgressBar}">
			<Setter
				Property="Template">
				<Setter.Value>
					<ControlTemplate
						x:Name="KDProgressBar"
						TargetType="{x:Type ProgressBar}">
						<Grid>
							<Rectangle
								x:Name="PART_Track"
								Height="5.5"
								HorizontalAlignment="Stretch"
								VerticalAlignment="Center"
								Fill="#9c7150"
								SnapsToDevicePixels="True" />
							<Rectangle
								x:Name="PART_Indicator"
								Height="5.5"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Fill="#d6361a"
								SnapsToDevicePixels="True" />
							<Ellipse
								x:Name="dot"
								Width="33"
								Height="33"
								HorizontalAlignment="Left"
								VerticalAlignment="Center"
								Stretch="Fill"
								ClipToBounds="True"
								SnapsToDevicePixels="True">
								<Ellipse.Style>
									<Style
										TargetType="Ellipse">
										<Style.Triggers>
											<DataTrigger
												Value="-1">
												<DataTrigger.Binding>
													<MultiBinding>
														<MultiBinding.Converter>
															<converter:CompareConverter />
														</MultiBinding.Converter>
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Value" />
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Minimum" />
													</MultiBinding>
												</DataTrigger.Binding>
												<Setter
													Property="Visibility"
													Value="Hidden" />
											</DataTrigger>

											<DataTrigger
												Value="0">
												<DataTrigger.Binding>
													<MultiBinding>
														<MultiBinding.Converter>
															<converter:CompareConverter />
														</MultiBinding.Converter>
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Value" />
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Minimum" />
													</MultiBinding>
												</DataTrigger.Binding>
												<Setter
													Property="Visibility"
													Value="Hidden" />
											</DataTrigger>

											<DataTrigger
												Value="1">
												<DataTrigger.Binding>
													<MultiBinding>
														<MultiBinding.Converter>
															<converter:CompareConverter />
														</MultiBinding.Converter>
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Value" />
														<Binding
															RelativeSource="{RelativeSource TemplatedParent}"
															Path="Minimum" />
													</MultiBinding>
												</DataTrigger.Binding>
												<Setter
													Property="Visibility"
													Value="Visible" />
											</DataTrigger>
										</Style.Triggers>
									</Style>
								</Ellipse.Style>
								<Ellipse.Fill>
									<RadialGradientBrush
										GradientOrigin="0.5,0.5"
										Center="0.5,0.5"
										RadiusX="0.5"
										RadiusY="0.5">
										<RadialGradientBrush.GradientStops>
											<GradientStop
												Color="White"
												Offset="0" />
											<GradientStop
												Color="#f58272"
												Offset="0.7" />
											<GradientStop
												Color="#e54e3c"
												Offset="1" />
										</RadialGradientBrush.GradientStops>
									</RadialGradientBrush>
								</Ellipse.Fill>
								<Ellipse.RenderTransform>
									<TranslateTransform
										X="{Binding Source={x:Reference PART_Indicator}, Path=ActualWidth}" />
								</Ellipse.RenderTransform>
							</Ellipse>
						</Grid>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>
	</UserControl.Resources>
	<Grid>
		<ProgressBar
			Width="200"
			Minimum="0"
			Maximum="100"
			Value="0"
			/>
	</Grid>
</UserControl>
