<Page x:Class="KDCtrlLib.RolePage"
	  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
	  xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
	  xmlns:local="clr-namespace:KDCtrlLib"
	  xmlns:localvm="clr-namespace:KDCtrlLib.ViewModel"
      xmlns:lib="clr-namespace:KDLib;assembly=KDLib"
	  mc:Ignorable="d" 
	  d:DesignHeight="450" d:DesignWidth="800"
	  xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	  Title="RolePage"
      DataContext="{Binding Role, Source={StaticResource Locator}}"
      >
	<Page.Resources>
		<ResourceDictionary Source="GlobalResource.xaml"/>
	</Page.Resources>
    <Grid>
        <materialDesign:Card
            VerticalAlignment="Center" 
			HorizontalAlignment="Center" 
			Width="350"
        >
            <DockPanel 
				Margin="20" 
				VerticalAlignment="Stretch" 
				HorizontalAlignment="Stretch" >
                <Button 
                    Command="{Binding AskPermision}"
					Margin="10" 
					MaxWidth="120" 
					FontSize="18"
					Content="Xác nhận" 
					DockPanel.Dock="Bottom"/>
                <ComboBox 
					materialDesign:HintAssist.Hint="Đây là máy của"
                    ItemsSource="{Binding Path=(lib:NetClient.ClientComboBoxChoose), UpdateSourceTrigger=PropertyChanged}"
                    SelectedItem="{Binding Choise, Mode=OneWayToSource}"
                    DisplayMemberPath="Name"
                    Margin="10" 
					Name="RoleChoices"
					DockPanel.Dock="Right" 
					FontSize="20"/>
            </DockPanel>
        </materialDesign:Card>
    </Grid>
</Page>
