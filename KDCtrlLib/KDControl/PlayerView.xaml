<UserControl
	x:Class="KDCtrlLib.KDControl.PlayerView"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	mc:Ignorable="d"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	Height="auto"
	MinWidth="300"
	x:Name="UC"
	>
	<materialDesign:Card
		Background="{Binding ElementName=UC, Path=Background}"
		materialDesign:ShadowAssist.ShadowDepth="Depth5"
		>
		<StackPanel
			Margin="5"
			MinWidth="250">
			<StackPanel.Resources>
				<Style
					TargetType="TextBlock">
					<Setter
						Property="FontSize"
						Value="40" />
					<Setter
						Property="Foreground"
						Value="{Binding ElementName=UC, Path=Foreground}"
						/>
					<Setter
						Property="FontWeight"
						Value="Black"
						/>
				</Style>
			</StackPanel.Resources>
			<Ellipse
				Grid.Column="0"
				Height="230"
				Width="230"
				Margin="15">
				<Ellipse.Fill>
					<ImageBrush
						ImageSource="{Binding Avatar}" />
				</Ellipse.Fill>
			</Ellipse>
			<TextBlock 
				MaxWidth="350"
				TextWrapping="Wrap"
				Margin="5"
				Width="auto"
				Height="auto"
				HorizontalAlignment="Center"
				Text="{Binding Name}"
				/>
			<TextBlock
				Width="auto"
				Height="auto"
				Margin="5"
				HorizontalAlignment="Center"
				Grid.Column="1"
				Grid.Row="1"
				Text="{Binding Score}" />
		</StackPanel>
	</materialDesign:Card>
</UserControl>
