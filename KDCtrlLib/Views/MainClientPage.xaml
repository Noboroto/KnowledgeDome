<Page
	x:Class="KDCtrlLib.Views.MainClientPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:lib="clr-namespace:KDLib;assembly=KDLib"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}"
	DataContext="{Binding MainClient, Source={StaticResource Locator}}"
	xmlns:control="clr-namespace:KDCtrlLib.KDControl"
	>
	<Page.Resources>
		<ResourceDictionary
			Source="GlobalResource.xaml" />
	</Page.Resources>
	<StackPanel
		VerticalAlignment="Center"
		HorizontalAlignment="Center"
		Orientation="Horizontal"
		>
		<StackPanel.Resources>
			<Style
				TargetType="control:PlayerView">
				<Setter
					Property="Margin"
					Value="35" />
			</Style>
		</StackPanel.Resources>
		<control:PlayerView
			x:Name="first"
			Visibility="Collapsed"
			Background="#d71b3b"
			Foreground="White"
			/>
		<control:PlayerView
			x:Name="second"
			Visibility="Collapsed"
			Background="#e8d71e"
			Foreground="Black" />
		<control:PlayerView
			x:Name="third"
			Visibility="Collapsed"
			Background="#16acea"
			Foreground="Black" />
		<control:PlayerView
			x:Name="fourth"
			Visibility="Collapsed"
			Background="#3a6b35"
			Foreground="White" />
		<control:PlayerView
			x:Name="fifth"
			Visibility="Collapsed"
			Background="#4203c9"
			Foreground="White" />
	</StackPanel>
</Page>
