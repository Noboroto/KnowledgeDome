<Page
	x:Class="KDCtrlLib.Views.RolePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:lib="clr-namespace:KDLib;assembly=KDLib"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}"
	DataContext="{Binding Role, Source={StaticResource Locator}}">
	<Page.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/KDCtrlLib;component/Views/GlobalResource.xaml" />
	</Page.Resources>
	<Grid>
		<materialDesign:Card
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Width="350">
			<DockPanel
				Margin="20"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch">
				<Button
					IsEnabled="{Binding AskRoleEnable}"
					Command="{Binding AskRole}"
					Margin="10"
					MaxWidth="120"
					FontSize="18"
					Content="Xác nhận"
					DockPanel.Dock="Bottom" />
				<ComboBox
					Name="ChoiceBox"
					materialDesign:HintAssist.Hint="Đây là máy của"
					ItemsSource="{Binding Roles, UpdateSourceTrigger=PropertyChanged}"
					SelectedIndex="{Binding Choice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
					Margin="10 15 10 10"
					DockPanel.Dock="Right"
					FontSize="20">
				</ComboBox>
			</DockPanel>
		</materialDesign:Card>
		<materialDesign:Snackbar
			x:Name="NoticeBar"
			MessageQueue="{materialDesign:MessageQueue}"
			HorizontalAlignment="Center"
			VerticalAlignment="Top" />
	</Grid>
</Page>
