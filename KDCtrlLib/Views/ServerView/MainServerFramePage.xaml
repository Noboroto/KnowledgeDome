<Page
	x:Class="KDCtrlLib.Views.ServerView.MainServerFramePage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:cmd="http://www.galasoft.ch/mvvmlight"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}"
	DataContext="{Binding MainFrame, Source={StaticResource Locator}}">
	<Page.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/KDCtrlLib;component/Views/GlobalResource.xaml" />
	</Page.Resources>
	<Grid>
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="5*" />
			<ColumnDefinition
				Width="5" />
			<ColumnDefinition
				Width="*" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="*" />
			<RowDefinition
				Height="5" />
			<RowDefinition
				Height="*" />
		</Grid.RowDefinitions>
		<Frame
			Source="{Binding FrameSource}"
			NavigationUIVisibility="Hidden"
			Grid.Column="0"
			Grid.Row="0"
			Grid.RowSpan="3" />
		<GridSplitter
			Grid.Column="1"
			Grid.RowSpan="3"
			Width="5"
			HorizontalAlignment="Stretch" />
		<GridSplitter
			Height="5"
			Grid.Column="2"
			Grid.Row="1"
			HorizontalAlignment="Stretch" />
		<Grid
			Margin="10"
			Grid.Column="2"
			Grid.Row="0"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch">
			<Grid.RowDefinitions>
				<RowDefinition />
				<RowDefinition
					Height="auto" />
			</Grid.RowDefinitions>
			<ListBox
				ItemsSource="{Binding Chatting}"
				IsTextSearchEnabled="False"
				FontSize="18"
				DockPanel.Dock="Top"
				FontFamily="Segoe UI"
				Name="Chatting"
				VirtualizingStackPanel.IsVirtualizing="True"
				Foreground="White"
				Grid.Column="2"
				Grid.Row="0"
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				SelectionMode="Single">
				<ListBox.ItemContainerStyle>
					<Style
						TargetType="ListBoxItem">
						<Setter
							Property="Template">
							<Setter.Value>
								<ControlTemplate
									TargetType="ListBoxItem">
									<WrapPanel
										Orientation="Horizontal">
										<TextBlock
											Foreground="{Binding ForegroundColor}"
											Text="{Binding Info}" />
										<TextBlock
											TextWrapping="Wrap"
											Text="{Binding Message}">
										</TextBlock>
									</WrapPanel>
								</ControlTemplate>
							</Setter.Value>
						</Setter>
					</Style>
				</ListBox.ItemContainerStyle>
			</ListBox>
			<TextBox
				x:Name="SendMessage"
				Margin="0 10 0 10"
				Grid.Row="1"
				TextWrapping="Wrap"
				HorizontalAlignment="Stretch"
				HorizontalContentAlignment="Left"
				AcceptsReturn="False"
				VerticalScrollBarVisibility="Auto"
				SpellCheck.IsEnabled="False"
				Text="{Binding WaitingSend, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
				materialDesign:HintAssist.Hint="Gửi đến MC"
				Height="auto">
				<i:Interaction.Triggers>
					<i:EventTrigger
						EventName="KeyDown">
						<cmd:EventToCommand
							PassEventArgsToCommand="True"
							Command="{Binding SendCmd}"
							/>
					</i:EventTrigger>
				</i:Interaction.Triggers>
			</TextBox>
		</Grid>
		<ListBox
			Grid.Column="2"
			Grid.Row="2"
			FontFamily="Segoe UI"
			IsTextSearchEnabled="False"
			FontSize="18"
			x:Name="Logging"
			ItemsSource="{Binding LogsView}"
			VirtualizingStackPanel.IsVirtualizing="True"
			Foreground="White"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			SelectionMode="Single">
			<ListBox.ItemContainerStyle>
				<Style
					TargetType="ListBoxItem">
					<Setter
						Property="Template">
						<Setter.Value>
							<ControlTemplate
								TargetType="ListBoxItem">
								<WrapPanel
									Orientation="Horizontal">
									<TextBlock
										Foreground="{Binding ForegroundColor}"
										Text="{Binding Info}" />
									<TextBlock
										TextWrapping="Wrap"
										Text="{Binding Message}">
									</TextBlock>
								</WrapPanel>
							</ControlTemplate>
						</Setter.Value>
					</Setter>
				</Style>
			</ListBox.ItemContainerStyle>
		</ListBox>
	</Grid>
</Page>
