<Page
	x:Class="KDCtrlLib.Views.ConnectPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	xmlns:i="http://schemas.microsoft.com/expression/2010/interactivity"
	xmlns:cmd="http://www.galasoft.ch/mvvmlight"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}"
	DataContext="{Binding Connect, Source={StaticResource Locator}}">
	<Page.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/KDCtrlLib;component/Views/GlobalResource.xaml" />
	</Page.Resources>
	<materialDesign:Card
		VerticalAlignment="Center"
		HorizontalAlignment="Center"
		materialDesign:ShadowAssist.ShadowDepth="Depth5"
		Width="400">
		<DockPanel
			Margin="20"
			VerticalAlignment="Stretch"
			HorizontalAlignment="Stretch">
			<Button
				Margin="10"
				Command="{Binding TryConnectCmd}"
				MaxWidth="100"
				FontSize="18"
				Content="Kết nối"
				DockPanel.Dock="Bottom" />
			<Label
				DockPanel.Dock="Left"
				FontSize="20"
				VerticalAlignment="Center"
				Content="IP máy chủ" />
			<TextBox
				Margin="10"
				Name="IPText"
				Text="{Binding IP, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}"
				DockPanel.Dock="Right"
				AcceptsReturn="False"
				FontSize="20">
				<i:Interaction.Triggers>
					<i:EventTrigger
						EventName="KeyDown">
						<cmd:EventToCommand
							PassEventArgsToCommand="True"
							Command="{Binding TryConnectEnterCmd}" />
					</i:EventTrigger>
				</i:Interaction.Triggers>
			</TextBox>
		</DockPanel>
	</materialDesign:Card>
</Page>