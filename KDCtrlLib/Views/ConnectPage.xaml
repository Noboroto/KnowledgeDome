<Page
	x:Class="KDCtrlLib.Views.ConnectPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}"
	DataContext="{Binding Connect, Source={StaticResource Locator}}"
	Loaded="OnNavigatedTo"
	Unloaded="OnNavigatingFrom">
	<Page.Resources>
		<ResourceDictionary
			Source="GlobalResource.xaml" />
	</Page.Resources>
	<Grid>
		<materialDesign:Card
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Width="400">
			<DockPanel
				Margin="20"
				VerticalAlignment="Stretch"
				HorizontalAlignment="Stretch">
				<Button
					Margin="10"
					Command="{Binding TryConnectCmd}"
					CommandParameter="{Binding ElementName=IPText, Path=Text}"
					MaxWidth="100"
					FontSize="18"
					Content="Kết nối"
					DockPanel.Dock="Bottom" />
				<Label
					DockPanel.Dock="Left"
					FontSize="20"
					VerticalAlignment="Center"
					Content="IP máy chủ" />
				<TextBox
					Margin="10"
					Name="IPText"
					Text="{Binding Source={StaticResource Locator}, Path=AppConfig.IP}"
					DockPanel.Dock="Right"
					AcceptsReturn="False"
					FontSize="20"
					KeyDown="IPText_KeyDown">
					<TextBox.InputBindings>
						<KeyBinding
							Key="Return"
							Command="{Binding TryConnectCmd, Mode=OneWay}"
							CommandParameter="{Binding Text, ElementName=IPText, UpdateSourceTrigger=PropertyChanged}" />
					</TextBox.InputBindings>
				</TextBox>
			</DockPanel>
		</materialDesign:Card>
		<materialDesign:Snackbar
			x:Name="NoticeBar"
			MessageQueue="{materialDesign:MessageQueue}"
			HorizontalAlignment="Center"
			VerticalAlignment="Top" />
	</Grid>
</Page>