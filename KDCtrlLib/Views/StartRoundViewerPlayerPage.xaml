<Page
	x:Class="KDCtrlLib.Views.StartRoundViewerPlayerPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	DataContext="{Binding StartRound, Source={StaticResource Locator}}"
	xmlns:control="clr-namespace:KDCtrlLib.KDControls"
	xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
	TextElement.Foreground="{DynamicResource MaterialDesignBody}"
	Background="{DynamicResource MaterialDesignPaper}"
	TextElement.FontWeight="Medium"
	TextElement.FontSize="14"
	FontFamily="{materialDesign:MaterialDesignFont}">
	<Page.Resources>
		<ResourceDictionary
			Source="pack://application:,,,/KDCtrlLib;component/Views/GlobalResource.xaml" />
	</Page.Resources>
	<Grid
		HorizontalAlignment="Stretch"
		VerticalAlignment="Stretch">
		<Grid.ColumnDefinitions>
			<ColumnDefinition
				Width="*" />
			<ColumnDefinition
				Width="auto" />
		</Grid.ColumnDefinitions>
		<Grid.RowDefinitions>
			<RowDefinition
				Height="5*" />
			<RowDefinition
				Height="auto" />
			<RowDefinition
				x:Name="LastRow"
				Height="2*" />
		</Grid.RowDefinitions>
		<control:AvatarPlayerSingleView
			DataContext="{Binding CurrentPlayer}"
			Grid.ColumnSpan="2"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			Grid.Row="0"
			Grid.Column="0">
			<control:AvatarPlayerSingleView.RenderTransform>
				<ScaleTransform
					CenterX="0.5"
					CenterY="0.5"
					ScaleX="1.2"
					ScaleY="1.2" />
			</control:AvatarPlayerSingleView.RenderTransform>
		</control:AvatarPlayerSingleView>
		<materialDesign:Card
			Grid.Row="2"
			x:Name="QuestionCard"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Margin="25 0 5 25"
			materialDesign:ShadowAssist.ShadowDepth="Depth5"
			Background="#222222"
			Foreground="White">
			<Border
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				BorderThickness="5"
				BorderBrush="#a48a61">
				<ScrollViewer
					HorizontalAlignment="Stretch"
					VerticalAlignment="Stretch"
					HorizontalScrollBarVisibility="Disabled"
					VerticalScrollBarVisibility="Auto">
					<TextBlock
						Margin="20"
						TextWrapping="Wrap"
						FontSize="50"
						DataContext="{Binding CurrentQuestion}"
						Text="{Binding Content}"
						TextAlignment="Left">
						<TextBlock.Style>
							<Style
								TargetType="TextBlock"
								BasedOn="{StaticResource MaterialDesignTextBlock}">
								<Style.Triggers>
									<DataTrigger
										Binding="{Binding Path=MainFrame.IsPlaying, Source={StaticResource Locator}}"
										Value="True"
										>
										<Setter
											Property="Visibility"
											Value="Visible"/>
									</DataTrigger>
									<DataTrigger
										Binding="{Binding Path=MainFrame.IsPlaying, Source={StaticResource Locator}}"
										Value="False">
										<Setter
											Property="Visibility"
											Value="Hidden" />
									</DataTrigger>
								</Style.Triggers>
							</Style>
						</TextBlock.Style>
					</TextBlock>
				</ScrollViewer>
			</Border>
		</materialDesign:Card>
		<materialDesign:Card
			Height="{Binding ElementName=QuestionCard, Path=ActualHeight}"
			Width="{Binding ElementName=QuestionCard, Path=ActualHeight}"
			Grid.Column="1"
			Grid.Row="2"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Margin="5 0 25 25"
			materialDesign:ShadowAssist.ShadowDepth="Depth5"
			Background="#222222"
			Foreground="White">
			<Border
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				BorderThickness="5"
				BorderBrush="#a48a61">
				<TextBlock
					Margin="10"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Name="ScoreTextBlock"
					FontSize="100"
					FontWeight="Bold"
					DataContext="{Binding CurrentPlayer}"
					Text="{Binding Score}"
					TextAlignment="Center" />
			</Border>
		</materialDesign:Card>
		<ProgressBar
			materialDesign:ShadowAssist.ShadowDepth="Depth5"
			Grid.Row="1"
			Grid.Column="0"
			BorderThickness="0"
			Foreground="#da371c"
			Background="#a48a61"
			materialDesign:TransitionAssist.DisableTransitions="True"
			Value="{Binding TimerLabel}"
			Minimum="0"
			Maximum="60"
			Width="auto"
			Height="35"
			Margin="25 0 5 5"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Bottom" />
		<TextBlock
			Text="{Binding TimerLabel, StringFormat=N0}"
			VerticalAlignment="Center"
			HorizontalAlignment="Center"
			FontSize="20"
			Grid.Row="1"
			Grid.Column="0" />
		<materialDesign:Card
			Width="{Binding ElementName=QuestionCard, Path=ActualHeight}"
			Grid.Column="1"
			Grid.Row="1"
			HorizontalAlignment="Stretch"
			VerticalAlignment="Stretch"
			Margin="5 0 25 5"
			materialDesign:ShadowAssist.ShadowDepth="Depth5"
			Background="#222222"
			Foreground="White">
			<Border
				HorizontalAlignment="Stretch"
				VerticalAlignment="Stretch"
				BorderThickness="5"
				BorderBrush="#a48a61">
				<TextBlock
					Text="{Binding QuestCount, StringFormat='Đã xong {0} câu'}"
					HorizontalAlignment="Center"
					VerticalAlignment="Center"
					Name="Counter"
					FontSize="20"
					TextAlignment="Center" />
			</Border>
		</materialDesign:Card>
	</Grid>
</Page>